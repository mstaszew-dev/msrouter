# --- Runtime ---
NODE_ENV=development
PORT=8787
# Optional bearer token clients must send to use the gateway. Empty = no auth.
GATEWAY_TOKEN=

# --- OpenRouter key pool ---
# Numbered keys are collected automatically (OPENROUTER_KEY1..N). Either form works.
OPENROUTER_KEY1=
OPENROUTER_KEY2=
OPENROUTER_KEY3=
# Additional OpenRouter models (comma-separated). Each model x each key becomes
# a chain entry. Empty by default; additional models are opt-in only.
# stealth/* models (e.g. stealth/union-alpha) are natively free at their base
# id and never gain a :free suffix (withFree skips the stealth/ namespace).
OPENROUTER_MODELS=
OPENROUTER_KEY4=
OPENROUTER_KEY5=
# (add OPENROUTER_KEY6..N as needed). Or a single key (parity with OpenRouter SDK):
OPENROUTER_API_KEY=
# Append ":free" to every OpenRouter model id before calling upstream.
FORCE_FREE=true
# Default OpenRouter model used when a client sends an alias (e.g. mst/free).
OPENROUTER_MODEL=openrouter/free
# Alias(es) that mean "walk every provider with its own default model".
# Send this as the "model" field to fan out across the whole chain
# (OpenRouter pool -> ZAI -> TokenRouter -> OpenCodeGo -> extras -> local tail).
WALK_ALIAS=mst/free,free

# --- Fallback providers (tried in order after the OpenRouter pool) ---
# OpenAI (direct)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# ZAI / GLM (Zhipu). Intl default; coding-plan subscriptions use
# https://api.z.ai/api/coding/paas/v4 (balance keys use /api/paas/v4).
# `thinking` is a CLIENT decision: whatever thinking field the client sends
# is forwarded verbatim; the gateway never injects or strips it.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5.3-flash
# TokenRouter (tokenrouter.com). OpenAI-compatible single-key aggregator with a
# free GLM tier. Routed after OpenAI/ZAI, before the extras. Keys are
# sk-prefixed and validated against api.tokenrouter.com (.io/.me are different
# services wanting tr_-prefixed keys).
# Pin it with direct:tokenrouter/<model> (note: direct:glm-... pins ZAI, not
# TokenRouter).
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_MODEL=z-ai/glm-5.3-free

# --- Laptop slot, absolute-last fallback ---
# Tailnet Ollama on the travelmate (2026-09-27; replaced the retired local
# qwen35-gw gateway 127.0.0.1:8091). Large contexts allowed by policy; the
# guard only enforces the 131072 window minus headroom (100K).
# OpenAI-compatible /v1, no API key. Routed ABSOLUTE LAST (weakest model):
# only serves when every remote provider and the local fallbacks are exhausted.
LAPTOP_ENABLED=false
LAPTOP_BASE_URL=https://mstro-travelmate-p215-52.taila0a683.ts.net/v1
LAPTOP_MODEL=qwen35-2b-64k
LAPTOP_TIMEOUT_MS=1800000

# --- Local provider (llama-server), routed LAST when enabled (fallback) ---
# Free, local, always has capacity: guarantees a response when every remote
# free tier is flapping. Speaks llama-server's OpenAI-compatible /v1 endpoint
# (the ollama daemon is NOT in use; llama-server does not implement /api/chat).
# Base URL includes /v1; the provider appends the bare 'chat/completions' suffix.
# Serve the patched 128K model with:
#   llama-server -m qwen2.5-1.5b-128k.gguf -c 131072 --rope-scaling yarn \
#     --yarn-orig-ctx 32768 --yarn-ext-factor 4 --alias qwen2.5:1.5b-128k
LOCAL_ENABLED=false
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=qwen2.5:1.5b-128k
# Local prefills are slow (~220-370 tok/s single-slot), so local gets its own
# timeout (default 300000) instead of the global UPSTREAM_TIMEOUT_MS. Lets big
# 128K prompts prefill; the campaign agent's client cap (2400s) covers this
# plus the walk deadline and the 1800s laptop tail.
LOCAL_TIMEOUT_MS=300000

# --- OpenCode Zen (/zen/v1) pool: REMOVED 2026-09-18 ---
# Every zen model 403s FreeTierError ("free tier can only be used from within
# OpenCode") for non-OpenCode clients, so the pool can never serve this
# gateway. The provider, env vars and pooling logic were deleted; OpenCodeGo
# (/zen/go/v1, below) is a separate pool and stays.

# --- Upstream call behavior ---
UPSTREAM_TIMEOUT_MS=60000
MAX_TRANSIENT_RETRIES=2
TRANSIENT_BACKOFF_MS=1000
# 429 cooldown: a rate-limited chain entry is parked (skipped by walks) this
# long. 0 disables parking (pre-cooldown behavior: every walk retries every entry).
RATE_LIMIT_COOLDOWN_MS=60000
# Wall-clock budget for one alias walk (mst/free). Once exceeded, remaining
# REMOTE entries are skipped (mid-entry retries too) and the walk fails over
# to the local tail (local/lmstudio/laptop) - slow-hanging remotes (keys x
# retries x timeout) must never starve the always-available fallback past the
# caller's deadline. Each enabled local entry keeps ONE post-deadline attempt,
# so size the client read timeout for the sum: deadline 300 + local-class
# first tries (300 each) + laptop 1800 = 2400s with the defaults below
# (python agent TIMEOUT_SECONDS=2400). 0 disables the deadline.
WALK_DEADLINE_MS=300000

# Stale-campaign detection: flag the campaign when events.jsonl has been idle
# this long. Raise when providers are slow - a legit mid-tick worker must not
# be killed (stale -> VPN rotation -> restartWorker). flag() takes lowercase
# true/1 only.
STALE_THRESHOLD_MINUTES=60

# Weak local tail (local/lmstudio/laptop) entries rotate to the back after N
# consecutive successes - they "always work", so without this they would
# accumulate preference over remote models.
SUCCESS_DEMOTE_LIMIT=5

# --- Scheduled agent worker: REMOVED ---
# src/worker.ts and the SCHEDULE_INTERVAL_MINUTES/AGENT_* vars were deleted
# with the unified-app refactor; the campaign agent runs under the Director
# (DIRECTOR_RUNNER) or manually.

# --- Director agent (observe-only supervisor) ---
# When false (default, standing policy): never spawn/kill/restart the campaign
# worker; observation, Slack and VPN rotation stay active.
DIRECTOR_AUTOSTART=false
# Minutes between observation cycles. -1 disables.
DIRECTOR_INTERVAL_MINUTES=-1
# Model for proposal drafting (empty = WALK_ALIAS[0] = mst/free).
DIRECTOR_MODEL=
# Campaign state the Director observes.
DIRECTOR_CAMPAIGN_DIR=/Users/mst/Downloads/job-search/job-apply
# OpenClaw workspace (where run-one-job lives).
DIRECTOR_OPENCLAW_WORKSPACE=/Users/mst/ZCodeProject/openclaw-job-search
# Launcher wrapper invoked on restart (default: the python campaign agent
# at /Users/mst/bin/job-search-agent; hermes was archived 2026-09-08).
# DIRECTOR_RUNNER=/path/to/launcher
# Single patch target the Director edits on approval ('~' is expanded).
DIRECTOR_OVERRIDES=~/.campaign-agent/director-overrides.env
# Ledger path (empty = <openclaw-workspace>/director/ledger.jsonl).
DIRECTOR_LEDGER=
# Minutes between Proton VPN IP rotations (0/negative disables; also fires on
# stale-campaign detection).
VPN_ROTATION_INTERVAL_MINUTES=30
# CDP health URL polled after a restart.
DIRECTOR_CDP_URL=http://127.0.0.1:9222
# Director RAG db override (empty = the shared openclaw rag/index.db).
DIRECTOR_RAG_DB=

# --- Slack (Director surface) ---
# Slack Bot Token (xoxb-...) for the Director to post messages.
SLACK_BOT_TOKEN=
# Slack Channel ID to post Director messages to.
SLACK_CHANNEL=
# Slack Webhook URL for outbound messages (alternative to Bot Token).
SLACK_WEBHOOK=

# --- Kafka (Director event streaming; disabled by default) ---
KAFKA_ENABLED=false
KAFKA_HOME=~/kafka/kafka_2.13-3.7.0
KAFKA_BOOTSTRAP=localhost:19092
KAFKA_POLL_INTERVAL_SECONDS=30

# --- Agent tools ---
# Comma-separated executable names the terminal tool may run (safety allowlist).
# DEFAULT excludes code-execution primitives (node/npm/find/git) which an
# LLM-driven agent can abuse (node -e, npm install, find -exec, git clone).
# Add them ONLY if you trust the agent and want that power.
TERMINAL_ALLOWLIST=ls,cat,echo,pwd,head,tail,grep

# --- Logging ---
LOG_LEVEL=info
# Comma-separated substring keys to redact from logs (case-insensitive).
LOG_REDACT=apikey,api_key,authorization,openrouter_key,opencode_api_key,zai_api_key,openai_api_key,tokenrouter_api_key,token,secret

# --- LM Studio (local; OpenAI-compatible, no API key needed) ---
LMSTUDIO_ENABLED=false
LMSTUDIO_BASE_URL=http://127.0.0.1:1235/v1
# Preferred model ALIAS only: the provider discovers loaded models at call
# time (GET {base}/models) and falls back to whichever local model is up,
# so model swaps don't require a restart. Parked since 2026-09-18 (the
# live 4B fleet on port 1235; 1234 was the retired 9B).
LMSTUDIO_MODEL=qwen3.5-4b
# Local prefills are slow (minutes for large prompts on the single-slot
# llama-server); LM Studio gets its own timeout instead of UPSTREAM_TIMEOUT_MS.
LMSTUDIO_TIMEOUT_MS=300000

# --- Web console (admin API + React dashboard) ---
# Port for the admin API server (default 8790); serves the built web console.
ADMIN_PORT=8790
# HS256 secret for admin-session JWTs. REQUIRED in production; when absent
# outside production the server generates an ephemeral one per boot.
JWT_SECRET=change-me-to-a-long-random-string
# Session lifetime in seconds (default 8h).
JWT_TTL_SECONDS=28800
# Flat-file users store for the console (scrypt-hashed passwords).
USERS_FILE=data/users.json
# Built web console directory; set to serve the SPA from the admin API.
WEB_DIST=web/dist
# Where the admin API finds the gateway for observability polling.
GATEWAY_URL=http://127.0.0.1:8787

# OpenCode Go ("go" endpoint variant): single-key provider (glm-5.3-flash).
OPENCODEGO_API_KEY=
OPENCODEGO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODEGO_MODEL=glm-5.3-flash
# OPENCODEGO_SESSION_ID=  # optional; defaults to a per-process random UUID

# --- Extra free-tier providers (2026-09-18). Each joins the walk only when
# key AND model are set; emptying a model var retires the slot. Cloudflare's
# OpenAI-compatible URL embeds the account id:
#   https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1 ---
UNOROUTER_API_KEY=
UNOROUTER_BASE_URL=https://api.unorouter.com/v1
UNOROUTER_MODEL=glm-5.3-flash:free
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
# Payment-gated upstream (2026-09-18): every model 402s without a card.
# Default is empty (slot retired); set a model only if you add a payment
# method (e.g. DeepSeek-V3.2).
SAMBANOVA_MODEL=
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Additional per-extra models (CSV, verified 2026-09-18; each becomes a walk
# entry; emptying a list retires just those entries).
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b
MISTRAL_MODELS=ministral-8b-latest,codestral-latest
# deepseek-v4-pro:free verified 200 on 2026-09-17, 503 upstream-busy on 09-18 (transient).
UNOROUTER_MODELS=nemotron-3-ultra-550b-a55b:free,deepseek-v4-pro:free
# Paid-plan-only on Workers Free (403, verified): @cf/zai-org/glm-5.3-flash,
# @cf/deepseek-ai/deepseek-v4-pro-0813, @cf/moonshotai/kimi-k2.7-code.
CLOUDFLARE_MODELS=@cf/openai/gpt-oss-120b,@cf/meta/llama-4-scout-17b-16e-instruct,@cf/qwen/qwen3.8-27b
SAMBANOVA_MODELS=
