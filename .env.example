# --- Runtime ---
NODE_ENV=development
PORT=8787
# Optional bearer token clients must send to use the gateway. Empty = no auth.
GATEWAY_TOKEN=

# --- OpenRouter key pool ---
# Numbered keys are collected automatically (OPENROUTER_KEY1..N). Either form works.
OPENROUTER_KEY1=
OPENROUTER_KEY2=
OPENROUTER_KEY3=
OPENROUTER_KEY4=
OPENROUTER_KEY5=
# (add OPENROUTER_KEY6..N as needed). Or a single key (parity with OpenRouter SDK):
OPENROUTER_API_KEY=
# Append ":free" to every OpenRouter model id before calling upstream.
FORCE_FREE=true
# Default OpenRouter model used when a client sends an alias (e.g. mst/free).
OPENROUTER_MODEL=openrouter/free
# Alias(es) that mean "walk every provider with its own default model".
# Send this as the "model" field to fan out across OpenRouter->OpenAI->ZAI->OpenCode.
WALK_ALIAS=mst/free

# --- Fallback providers (tried in order after the OpenRouter pool) ---
# OpenAI (direct)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# ZAI / GLM (Zhipu). Intl default; switch the base URL for domestic (open.bigmodel.cn).
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.6
# --- OpenCode Zen (BigPickle + free variants), POOLED ---
# Numbered keys are collected automatically (OPENCODE_KEY1..N), ascending,
# deduped. The candidate queue is model-major, key-minor: each model variant is
# tried against each key. Either form works.
OPENCODE_KEY1=
OPENCODE_KEY2=
OPENCODE_KEY3=
# Legacy single-key form (still collected, appended last if not a duplicate):
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=big-pickle
# Additional OpenCode Zen free models (all share the OPENCODE_KEY1..N pool).
OPENCODE_NEMOTRON_MODEL=nemotron-3-ultra-free
OPENCODE_DEEPSEEK_FLASH_MODEL=deepseek-v4-flash-free
OPENCODE_MIMO_MODEL=mimo-v2.5-free
OPENCODE_NORTH_MINI_CODE_MODEL=north-mini-code-free
OPENCODE_LAGUNA_MODEL=laguna-s-2.1-free
OPENCODE_LING_MODEL=ling-3.0-flash-free
OPENCODE_QWEN_MODEL=qwen3.6-plus-free
OPENCODE_MINIMAX_MODEL=minimax-m3-free

# --- Upstream call behavior ---
UPSTREAM_TIMEOUT_MS=60000
MAX_TRANSIENT_RETRIES=2
TRANSIENT_BACKOFF_MS=1000

# --- Scheduled agent worker (separate process: `npm run worker`) ---
# Minutes between runs. -1 disables the scheduler.
SCHEDULE_INTERVAL_MINUTES=-1
AGENT_MODEL=
AGENT_PROMPT=
AGENT_GOAL=
AGENT_MAX_STEPS=20
# LLM-judge for goal-met detection (off by default; cheap heuristic first).
AGENT_LLM_JUDGE=false

# --- Director agent (separate worker: `npm run director-worker`) ---
# Minutes between observation cycles. -1 disables.
DIRECTOR_INTERVAL_MINUTES=-1
# Model for proposal drafting (empty = WALK_ALIAS[0] = mst/free).
DIRECTOR_MODEL=
# Campaign state the Director observes.
DIRECTOR_CAMPAIGN_DIR=/Users/mst/Downloads/job-search/job-apply
# OpenClaw workspace (where run-one-job lives).
DIRECTOR_OPENCLAW_WORKSPACE=/Users/mst/ZCodeProject/openclaw-job-search
# Launcher wrapper invoked on restart.
DIRECTOR_RUNNER=~/.openclaw/director-launch
DIRECTOR_PIDFILE=~/.openclaw/run-one-job.pid
# Single patch target the Director edits on approval.
DIRECTOR_OVERRIDES=~/.openclaw/director-overrides.env
# Ledger path (empty = <openclaw-workspace>/director/ledger.jsonl).
DIRECTOR_LEDGER=
# CDP health URL polled after a restart.
DIRECTOR_CDP_URL=http://127.0.0.1:9222
# Director-owned SQLite RAG db (empty = <msrouter>/src/director/rag/index.db).
DIRECTOR_RAG_DB=

# --- Slack (Director surface) ---
# Slack Bot Token (xoxb-...) for the Director to post messages.
SLACK_BOT_TOKEN=
# Slack Channel ID to post Director messages to.
SLACK_CHANNEL=
# Slack Webhook URL for outbound messages (alternative to Bot Token).
SLACK_WEBHOOK=

# --- Agent tools ---
CDP_URL=http://127.0.0.1:9222
# Comma-separated executable names the terminal tool may run (safety allowlist).
# DEFAULT excludes code-execution primitives (node/npm/find/git) which an
# LLM-driven agent can abuse (node -e, npm install, find -exec, git clone).
# Add them ONLY if you trust the agent and want that power.
TERMINAL_ALLOWLIST=ls,cat,echo,pwd,head,tail,grep

# --- Logging ---
LOG_LEVEL=info
# Comma-separated substring keys to redact from logs (case-insensitive).
LOG_REDACT=apikey,api_key,authorization,openrouter_key,opencode_api_key,zai_api_key,openai_api_key,token,secret
