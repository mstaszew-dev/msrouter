{
  "name": "msrouter",
  "version": "1.0.0",
  "private": true,
  "description": "Local OpenRouter-compatible gateway: pools OpenRouter free-model keys with OpenAI / ZAI (GLM) / OpenCode Zen (BigPickle) fallback, plus a scheduled MCP-style agent runner (terminal + browser tools).",
  "license": "MIT",
  "author": "Michael Staszewski",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx src/worker.ts",
    "director-worker": "node dist/director-worker.js",
    "director-worker:dev": "tsx src/director-worker.ts",
    "director-kafka-poller": "node dist/director-kafka-poller.js",
    "director-kafka-poller:dev": "tsx src/director-kafka-poller.ts",
    "director-slack-sender": "node dist/director-slack-sender.js",
    "director-slack-sender:dev": "tsx src/director-slack-sender.ts",
    "kafka": "bash scripts/kafka.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:rag": "bash -c 'cd src/director/rag && .venv/bin/python -m pytest tests -q'",
    "test:rag:cov": "bash -c 'cd src/director/rag && .venv/bin/python -m pytest tests --cov=rag_server --cov=index_builder --cov-report=term-missing -q'",
    "prepare": "husky || true"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "graphql": "^17.0.2",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "playwright-core": "^1.49.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/node": "^20.17.10",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
